@page
@model CrewViewer.Pages.Crews.ExecutionListModel

@{
    ViewData["Title"] = "Historique des exécutions";
}

<div class="container py-4">
    <h2 class="mb-3">
        <i class="bi bi-clock-history"></i>
        Exécutions pour @Model.Crew?.name (@Model.Crew?.code)
    </h2>

    <a asp-page="./Index" class="btn btn-outline-secondary mb-3">
        <i class="bi bi-arrow-left"></i> Retour
    </a>

    <div class="card shadow-sm">
        <table class="table table-dark table-striped mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Début</th>
                    <th>Fin</th>
                    <th>Statut</th>
                    <th class="text-end">Voir</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var exec in Model.Executions)
                {
                    <tr>
                        <td>@exec.id</td>
                        <td>@exec.started_at</td>
                        <td>@exec.finished_at</td>
                        <td>
                            <span class="badge bg-@(exec.status == "success" ? "success" : "danger")">
                                @exec.status
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-page="./ExecutionLog"
                               asp-route-id="@exec.id"
                               class="btn btn-sm btn-primary">
                                <i class="bi bi-eye"></i> Log
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
